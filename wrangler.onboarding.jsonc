{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "max-ops-one-click",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "max-ops-onboarding",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./drizzle-onboarding"
    }
  ],
  "vars": {
    "MAXOPS_INSTALL_PUBLIC_ORIGIN": "https://install.example",
    "MAXOPS_ONBOARDING_ONLY": "true",
    "MAXOPS_OAUTH_SCOPES": "bitable:app offline_access"
  },
  "observability": {
    "enabled": true
  }
}
